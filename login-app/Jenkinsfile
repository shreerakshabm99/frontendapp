pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/shreerakshabm99/frontendapp.git', branch: 'dev'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('login-app') {
                    // Install project dependencies including sonar-scanner
                    bat 'npm install'
                    // Also install sonar-scanner locally (if not already in package.json)
                    bat 'npm install sonar-scanner --save-dev'
                }
            }
        }

        stage('Build') {
            steps {
                dir('login-app') {
                    bat 'npm run build'
                }
            }
        }

        stage('Test') {
            steps {
                dir('login-app') {
                    bat 'npm test -- --coverage --watchAll=false --passWithNoTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('login-app') {
                    withSonarQubeEnv('SonarQube Server') {
                        // Use local sonar-scanner from node_modules
                        bat '.\\node_modules\\.bin\\sonar-scanner.cmd'
                    }
                }
            }
        }

        stage('Archive Build') {
            steps {
                dir('login-app') {
                    archiveArtifacts artifacts: 'build/**', fingerprint: true
                }
            }
        }
    }
}
