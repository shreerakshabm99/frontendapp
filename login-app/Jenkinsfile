
pipeline {
    agent any



    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/shreerakshabm99/frontendapp.git', branch: 'dev'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Archive Build') {
            steps {
                archiveArtifacts artifacts: 'build/**', fingerprint: true
            }
        }
    }
}
